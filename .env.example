INSTAGRAM_ACCESS_TOKEN=pon_aqui_el_token_de_instagram
INSTAGRAM_USER_ID=me
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com

# Solicitudes y presupuestos: no activar hasta configurar todos los servicios.
QUOTES_ENABLED=false
PUBLIC_SITE_URL=https://www.factorlambda.com
SUPABASE_URL=
# Server-only: accepts modern sb_secret_... or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
QUOTE_ADMIN_PASSWORD=
QUOTE_WORKSHOP_PASSWORD=
QUOTE_LINK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
QUOTE_EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_QUOTE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=es
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Defaults remain disabled. Live mode additionally requires explicit approval.
STRIPE_MODE=test
STRIPE_CHECKOUT_ENABLED=false
STRIPE_LIVE_APPROVED=false
# FL VIP: enable only after migration, catalog, 21% inclusive tax and webhook tests.
VIP_ENABLED=false
# Set once and keep stable; required to decrypt registered DNI/NIE values.
# If omitted, the existing QUOTE_LINK_SECRET is used with a separate key derivation.
VIP_IDENTITY_SECRET=
VIP_PRICE_ESSENTIAL_MONTHLY=
VIP_PRICE_ESSENTIAL_ANNUAL=
VIP_PRICE_PERFORMANCE_MONTHLY=
VIP_PRICE_PERFORMANCE_ANNUAL=
VIP_PRICE_ELITE_MONTHLY=
VIP_PRICE_ELITE_ANNUAL=
VIP_TAX_CONFIRMED=false
