{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "outputs/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {"src":"/api/tlr-catalog","dest":"/api/tlr-catalog.js"},
    {
      "src": "/",
      "dest": "/outputs/index.html"
    },
    {
      "src": "/api/instagram-feed",
      "dest": "/api/instagram-feed.js"
    },
    {
      "src": "/api/repro-quotes",
      "dest": "/api/repro-quotes.js"
    },
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/personaliza.html",
      "status": 302,
      "headers": { "Location": "/" }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/outputs/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/outputs/$1"
    }
  ]
}
