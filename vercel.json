{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "outputs/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/outputs/index.html"
    },
    {
      "src": "/api/instagram-feed",
      "dest": "/api/instagram-feed.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/outputs/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/outputs/$1"
    }
  ]
}
