{
  "version": 2,
  "public": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/outputs/index.html"
    },
    {
      "source": "/api/instagram-feed",
      "destination": "/api/instagram-feed.js"
    },
    {
      "source": "/(.*)",
      "destination": "/outputs/$1"
    }
  ]
}
